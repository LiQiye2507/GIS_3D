        <mxCell id="sheet4_toae_62" value="&lt;b&gt;GHI CHÚ QUY LUẬT BỐ TRÍ MẶT BẰNG TÒA E:&lt;/b&gt;&lt;br&gt;&lt;br&gt;• &lt;b&gt;Tầng 1 (Khác biệt):&lt;/b&gt; Khu vực Thang máy nằm trên Sảnh chính; không có phòng Kho cạnh Thang bộ; gồm 3 phòng trên (E01.3, E01.5, E01.7), 1 phòng trái (E01.01) và 2 phòng dài phía dưới (E01.2, E01.4).&lt;br&gt;&lt;br&gt;• &lt;b&gt;Tầng 2, 3, 4 (Nhóm mặt bằng 2 phòng dưới):&lt;/b&gt; Hàng trên có thêm phòng &lt;b&gt;Kho&lt;/b&gt; cạnh Thang bộ/Thoát hiểm + 2 phòng lẻ (.3, .5); hàng dưới gồm 2 phòng chẵn dài (.2, .4).&lt;br&gt;&lt;br&gt;• &lt;b&gt;Tầng 5 – 11 (Nhóm mặt bằng chuẩn 4 phòng dưới):&lt;/b&gt; Hàng trên giống Tầng 3 (WC, Thang máy, Thang bộ/Thoát hiểm, Kho, .3, .5); hàng dưới chia đều thành 4 phòng chẵn (.2, .4, .6, .8).&lt;br&gt;&lt;br&gt;• &lt;b&gt;Tầng 12 (Khác biệt - Hội trường):&lt;/b&gt; Phần bên phải gộp thông tầng hành lang và hàng dưới thành &lt;b&gt;Hội trường lớn (HTE)&lt;/b&gt;." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontFamily=Arial;fontSize=12;fillColor=#F9F9F9;strokeWidth=1.5;fontSize=11;align=left;spacingLeft=10;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="430" y="840" width="400" height="290" as="geometry" />
        </mxCell>
        <mxCell id="sheet4_toae_63" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontFamily=Arial;fontSize=12;strokeWidth=2;fillColor=#FFFFFF;" vertex="1" parent="1">
          <mxGeometry x="870" y="95" width="980" height="290" as="geometry" />
        </mxCell>
        <mxCell id="sheet4_toae_64" value="&lt;b&gt;1. SƠ ĐỒ HƯỚNG DẪN CÁC PHÒNG HỌC TÒA NHÀ E – TẦNG 1&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontFamily=Arial;fontSize=12;strokeColor=none;fillColor=none;fontSize=16;" vertex="1" parent="1">
          <mxGeometry x="890" y="107" width="940" height="32" as="geometry" />
        </mxCell>
